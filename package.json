{
  "name": "planning-poker",
  "private": true,
  "description": "Planning poker em tempo real, com votos protegidos por RLS no Postgres.",
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "smoke": "pnpm --filter @pp/db smoke",
    "seed": "pnpm --filter @pp/db seed",
    "demo:consenso": "pnpm --filter @pp/db demo:consenso",
    "db:start": "pnpm --filter @pp/db start",
    "db:reset": "pnpm --filter @pp/db reset",
    "db:stop": "pnpm --filter @pp/db stop"
  },
  "devDependencies": {
    "turbo": "^2.5.9",
    "typescript": "~6.0.2"
  }
}
